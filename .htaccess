Options -Indexes

RewriteEngine On

RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:\d+)?$ [NC]
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# Quitar /public de las solicitudes directas sin afectar la reescritura interna.
RewriteCond %{THE_REQUEST} \s/+public(?:/|\?|\s) [NC]
RewriteRule ^public/?(.*)$ /$1 [R=301,L]

# Compatibilidad para rutas de imágenes guardadas cuando el proyecto se llamaba
# /fundaciondu; los archivos actuales se sirven desde public/uploads.
RewriteRule ^fundaciondu/public/uploads/([A-Za-z0-9_.-]+)$ public/uploads/$1 [L,NC]
RewriteRule ^(?:app|config|database|vendor|README\.MD|composer\.(?:json|lock)|\.git|\.env)(?:/|$) public/error.php?code=403 [L,NC]

# Servir los archivos SEO desde la carpeta publica sin pasar por el router PHP.
RewriteRule ^robots\.txt$ public/robots.txt [END,NC]
RewriteRule ^sitemap\.xml$ public/sitemap.xml [END,NC]

RewriteRule ^public/ - [L]
RewriteRule ^$ public/ [L]
RewriteRule ^(.*)$ public/$1 [L]